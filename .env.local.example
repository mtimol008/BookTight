# Copy this file to .env.local and fill in your Supabase project's values.
# Find these in the Supabase dashboard: Settings > API Keys.
#
# The "publishable" key is safe to expose in browser code (that's what
# NEXT_PUBLIC_ means) — it only grants what your Row Level Security
# policies allow. Never put the "secret" key in a NEXT_PUBLIC_ variable.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Grants full admin access — bypasses Row Level Security entirely. Server-only,
# used for things the regular client genuinely can't do: deleting a user's
# auth account, and the app-level rate-limit checks. Never expose this to the
# browser, never prefix it NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Mapbox Geocoding API — find/create a token at https://account.mapbox.com/access-tokens/
# Deliberately NOT prefixed with NEXT_PUBLIC_: geocoding runs in server actions
# only, so this key never reaches the browser.
MAPBOX_ACCESS_TOKEN=

# Cloudflare Turnstile — create a site at https://dash.cloudflare.com/?to=/:account/turnstile
# The site key renders the widget in the browser (safe to expose); the
# secret key verifies the resulting token server-side and must never be
# prefixed NEXT_PUBLIC_.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Kill switch — set to "true" to disable Turnstile everywhere (forms stop
# requiring a token, server stops verifying) with no code change. Use this
# if a bad key pair or a Cloudflare outage is locking everyone out of
# login/signup/password-reset. Leave unset/false normally.
NEXT_PUBLIC_TURNSTILE_DISABLED=

# Sentry — create a project at https://sentry.io/
# The DSN is just an ingest endpoint, not a secret — safe to expose client-side.
NEXT_PUBLIC_SENTRY_DSN=
