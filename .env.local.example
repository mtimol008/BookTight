# Copy this file to .env.local and fill in your Supabase project's values.
# Find these in the Supabase dashboard: Settings > API Keys.
#
# The "publishable" key is safe to expose in browser code (that's what
# NEXT_PUBLIC_ means) — it only grants what your Row Level Security
# policies allow. Never put the "secret" key in a NEXT_PUBLIC_ variable.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Grants full admin access — bypasses Row Level Security entirely. Server-only,
# used for things the regular client genuinely can't do: deleting a user's
# auth account, and the app-level rate-limit checks. Never expose this to the
# browser, never prefix it NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Mapbox Geocoding API — find/create a token at https://account.mapbox.com/access-tokens/
# Deliberately NOT prefixed with NEXT_PUBLIC_: geocoding runs in server actions
# only, so this key never reaches the browser.
MAPBOX_ACCESS_TOKEN=

# Cloudflare Turnstile — create a site at https://dash.cloudflare.com/?to=/:account/turnstile
# The site key renders the widget in the browser (safe to expose); the
# secret key verifies the resulting token server-side and must never be
# prefixed NEXT_PUBLIC_.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Kill switch — set to "true" to disable Turnstile everywhere (forms stop
# requiring a token, server stops verifying) with no code change. Use this
# if a bad key pair or a Cloudflare outage is locking everyone out of
# login/signup/password-reset. Leave unset/false normally.
NEXT_PUBLIC_TURNSTILE_DISABLED=

# Sentry — create a project at https://sentry.io/
# The DSN is just an ingest endpoint, not a secret — safe to expose client-side.
NEXT_PUBLIC_SENTRY_DSN=

# Resend — create an API key at https://resend.com/api-keys, scoped to the
# verified mail.booktight.co.uk sending domain. Used by the deletion-warning
# cron (src/lib/email.ts) to send its reminder emails.
RESEND_API_KEY=

# A random secret you make up yourself (any long random string). Set the
# same value in Vercel -> Settings -> Environment Variables, and Vercel
# sends it back as "Authorization: Bearer <value>" on every cron request —
# src/app/api/cron/deletion-warnings checks it so nobody else can trigger
# that route.
CRON_SECRET=

# Switch — set to "true" to let the paywall actually enforce entitlement
# (job actions become read-only once an account lapses). Leave unset/false
# during the beta.
PAYWALL_ENABLED=

# The date the paywall actually goes live, e.g. "2026-12-01". Required once
# PAYWALL_ENABLED=true — it's the floor under every account's deletion
# clock (src/lib/entitlement.ts effectiveLapsedAt), so an existing beta
# account's long-past trial_ends_at can never make it look like it lapsed
# before the paywall even started enforcing anything.
PAYWALL_LIVE_FROM=

# Switch — set to "true" to let the deletion-warning cron actually delete
# lapsed accounts once they're 90+ days overdue. Leave unset/false to let
# the warning emails run for real while deletion itself stays off.
DELETION_ENABLED=
